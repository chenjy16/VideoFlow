{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoFlow",
  "version": "1.0.0",
  "identifier": "app.videoflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VideoFlow",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg", "binaries/ffprobe"],
    "resources": {
      "../licenses": "LICENSES"
    },
    "category": "Video",
    "shortDescription": "Video and audio downloader",
    "longDescription": "A native macOS video and audio downloader powered by yt-dlp.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
