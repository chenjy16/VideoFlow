{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "VideoFlow 主窗口所需的默认权限集合",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default",
    "notification:default",
    "log:default"
  ]
}
